# ==============================================================================
# RestockPilot — Environment Configuration Template
# Copy this file to .env.local: cp .env.example .env.local
# All secrets remain strictly server-side. Never prefix with NEXT_PUBLIC_.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PayPal Sandbox Developer Credentials
# Obtain from https://developer.paypal.com/dashboard/applications/sandbox
# REST App with Orders v2 ("CAPTURE" intent) permissions.
# ------------------------------------------------------------------------------
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_SECRET=your_sandbox_client_secret
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_ENV=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# ------------------------------------------------------------------------------
# 2. PayPal Webhook Configuration
# Register your live URL (e.g. https://your-domain.com/api/paypal/webhook) in
# developer.paypal.com -> Apps & Credentials -> Webhooks, and paste Webhook ID.
# ------------------------------------------------------------------------------
PAYPAL_WEBHOOK_ID=your_sandbox_webhook_id

# ------------------------------------------------------------------------------
# 3. Channel3 Multi-Retailer Product Discovery API
# Obtain from https://trychannel3.com/
# Powers live supplier search, multi-merchant comparisons, and peer median calculation.
# ------------------------------------------------------------------------------
CHANNEL3_API_KEY=your_channel3_api_key

# ------------------------------------------------------------------------------
# 4. Google Gemini Multimodal AI
# Obtain from https://aistudio.google.com/docs/api-key
# Used for owner plain-English mandate parsing and offer explanation.
# (Resilient model chain automatically falls back if rate limits occur)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key

# ------------------------------------------------------------------------------
# 5. Optional AI Providers (Fallback Chain)
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key
OPENAI_API_KEY=your_openai_api_key

# ------------------------------------------------------------------------------
# 6. Docket Receipt Signing Secret (RestockPilot)
# HMAC-SHA256 key that seals signed docket receipts (src/lib/receipt-verifier.ts).
# If unset, a public fallback key from the repository is used — anyone with the
# source can forge receipts. Generate a strong secret, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ------------------------------------------------------------------------------
RECEIPT_SIGNING_SECRET=

# 7. Morning Run (scheduled draft-only restock proposals)
# Bearer token required by GET/POST /api/cron/morning-run. Leave empty to DISABLE the endpoint.
CRON_SECRET=

# 8. Daily AI model-call cap (protects free-tier quota; default 60). Past the cap the app serves a labelled deterministic replay.
AI_DAILY_CALL_CAP=60
# 9. API access control for mutating / privileged routes (src/lib/api-guard.ts)
# Operator key: send as "Authorization: Bearer <key>" or "x-operator-key". Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OPERATOR_API_KEY=
# Sandbox demo only. When "true" AND PAYPAL_ENVIRONMENT=SANDBOX, same-origin browser requests may
# use the guarded demo routes without the operator key. Leave unset for any real deployment.
ALLOW_PUBLIC_DEMO_WRITES=
# Debug judge endpoint /api/test-bar is disabled in production unless this is "true".
ENABLE_TEST_BAR=
# Dev only (ignored in production): accept unsigned PayPal webhook events for local testing.
ALLOW_UNSIGNED_WEBHOOKS=
# Explicit opt-in to sign receipts with the PUBLIC fallback key in production (sandbox demo only).
ALLOW_INSECURE_DEMO_RECEIPT_KEY=

# 10. User authentication (Google OAuth 2.0 + guest demo mode)
# Create an OAuth "Web application" client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback (and your deployed URL)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: override the callback URL (defaults to <public origin>/api/auth/google/callback)
GOOGLE_REDIRECT_URI=
# Optional: public base URL behind a proxy, e.g. https://verisettle-web.onrender.com (no trailing slash).
# When set, it is used for all auth redirects instead of the forwarded Host header.
APP_BASE_URL=
# Signs session cookies (min 16 chars). Recommended in production; if unset, a key is derived
# from OPERATOR_API_KEY. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Optional: public base URL used for auth redirects (e.g. https://verisettle-web.onrender.com).
# Defaults to the forwarded host/proto of the request.
APP_BASE_URL=
